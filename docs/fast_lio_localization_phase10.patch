+def publish_registration_quality(fitness, mean_residual, correspondence_count, source_point_count):
+    quality = RegistrationQuality()
+    quality.header.stamp = node.get_clock().now().to_msg()
+    quality.header.frame_id = 'map'
+    quality.valid = (
+        math.isfinite(fitness)
+        and math.isfinite(mean_residual)
+        and source_point_count > 0
+        and 0 <= correspondence_count <= source_point_count
+    )
+    quality.accepted = quality.valid and fitness > LOCALIZATION_TH
+    quality.fitness = float(fitness) if math.isfinite(fitness) else math.nan
+    quality.mean_residual = (
+        float(mean_residual) if math.isfinite(mean_residual) else math.nan
+    )
+    quality.correspondence_count = max(0, int(correspondence_count))
+    quality.source_point_count = max(0, int(source_point_count))
+    pub_registration_quality.publish(quality)
